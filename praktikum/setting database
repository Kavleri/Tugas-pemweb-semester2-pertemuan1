CREATE DATABASE web_project;

USE web_project;

CREATE TABLE siswa (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nama VARCHAR(100),
    matkul VARCHAR(100),
    nilai_uts INT,
    nilai_uas INT,
    nilai_tugas INT,
    nilai_akhir FLOAT,
    kelulusan VARCHAR(20),
    grade CHAR(1)
);

CREATE TABLE registrasi (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nim VARCHAR(20),
    nama VARCHAR(100),
    prodi VARCHAR(50),
    skill TEXT,
    skor_skill INT,
    kategori VARCHAR(20)
);

